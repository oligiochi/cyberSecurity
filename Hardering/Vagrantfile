Vagrant.configure("2") do |config|
  # ==========================
  # BOX BASE
  # ==========================
  config.vm.box = "onlyoffice/base-debian13"
  config.vm.hostname = "debian13-lab"

  # SSH forward per accesso locale
  config.vm.network "forwarded_port", guest: 22, host: 2223, auto_correct: true
  config.ssh.insert_key = false

  # ==========================
  # FASE 1: aggiornamento sistema + pacchetti essenziali
  # ==========================
  config.vm.provision "shell", inline: <<-SHELL
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y sudo openssh-server vim bash-completion nmap
  SHELL

  # ==========================
  # FASE 2: configurazione SSH
  # ==========================
  config.vm.provision "shell", inline: <<-SHELL
    mkdir -p /etc/ssh/sshd_config.d

    cat > /etc/ssh/sshd_config.d/PermitRootLogin-custom.conf <<'EOF'
PermitRootLogin yes
PasswordAuthentication yes
EOF

    systemctl enable ssh
    systemctl restart ssh
  SHELL

  # ==========================
  # FASE 3: utenti
  # ==========================
  config.vm.provision "shell", inline: <<-SHELL
    # Imposta password root
    echo 'root:root' | chpasswd

    # Utente studente (senza privilegi sudo)
    useradd -m -s /bin/bash studente
    echo 'studente:studente' | chpasswd

    # Utente exam con sudo NOPASSWD (simula utente fornito all’esonero)
    useradd -m -s /bin/bash exam
    echo 'exam:exam' | chpasswd
    echo 'exam ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/exam
    chmod 440 /etc/sudoers.d/exam
  SHELL

  # ==========================
  # VirtualBox provider
  # ==========================
  config.vm.provider "virtualbox" do |vb|
    vb.memory = 1024
    vb.cpus = 1
    vb.gui = false
  end
end
